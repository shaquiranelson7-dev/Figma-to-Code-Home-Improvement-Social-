---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Partnership from "../components/Partnership.astro";
import AboutUs from "../components/AboutUs.astro";
import Services from "../components/Services.astro";
import HowWeWork from "../components/HowWeWork.astro";
import Testimonials from "../components/Testimonials.astro";
import Pricing from "../components/Pricing.astro";
import Blogs from "../components/Blogs.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Upmind — Clear insights. Real strategy. Sustainable growth."
  description="Upmind helps startups and growing teams validate ideas, scale products, and make data-driven decisions."
>
  <Hero />
  <main id="main">
    <Partnership />
    <AboutUs />
    <Services />
    <HowWeWork />
    <Testimonials />
    <Pricing />
    <Blogs />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
