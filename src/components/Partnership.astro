---
// Partnership section — Upmind landing page
// Built from Figma file sdLaVofRVJRIdYko2En4hi, node 1:265

type Logo = {
  name: string;
  src: string;
  w: number;
  h: number;
  card: boolean;
  greenish?: boolean;
};

const logos: Logo[] = [
  { name: "Vision", src: "/assets/images/logo-vision.svg", w: 107.969, h: 22.331, card: true },
  { name: "Network", src: "/assets/images/logo-network.svg", w: 200, h: 72, card: false },
  { name: "Flash", src: "/assets/images/logo-flash.svg", w: 103.045, h: 26.862, card: true },
  { name: "Cactus", src: "/assets/images/logo-cactus.svg", w: 111.504, h: 28.647, card: true },
  { name: "Vision", src: "/assets/images/logo-vision-2.svg", w: 89.209, h: 20.267, card: true },
  { name: "Greenish", src: "/assets/images/logo-greenish-text.svg", w: 77.293, h: 14.966, card: true, greenish: true },
  { name: "Vision", src: "/assets/images/logo-vision-3.svg", w: 107.969, h: 22.331, card: true },
  { name: "Network", src: "/assets/images/logo-network.svg", w: 200, h: 72, card: false },
  { name: "Cactus", src: "/assets/images/logo-cactus-2.svg", w: 111.504, h: 28.647, card: true },
  { name: "Vision", src: "/assets/images/logo-vision-4.svg", w: 89.209, h: 20.267, card: true },
  { name: "Greenish", src: "/assets/images/logo-greenish-text.svg", w: 77.293, h: 14.966, card: true, greenish: true },
];

const stats = [
  { value: "95%", label: "Complete customer satisfaction" },
  { value: "20+", label: "Innovation and valuable insight" },
  { value: "$5M+", label: "Highly efficient strategies" },
];
---

<section class="partnership">
  <div class="partnership__inner container">
    <div class="partnership__top">
      <div class="partnership__tag">
        <img
          class="partnership__tag-dot"
          src="/assets/images/partnership-tag-dot.svg"
          alt=""
          role="presentation"
          width="4"
          height="4"
        />
        <span class="partnership__tag-label">Partnerships</span>
      </div>

      <div class="partnership__content">
        <h2 class="partnership__heading">
          Over a decade helping early-stage businesses grow.
        </h2>
        <p class="partnership__body">
          From idea validation to advanced growth, we combine strategic insight
          and modern tools to help your startup make smarter decisions and scale
          faster in a rapidly changing market.
        </p>

        <div class="partnership__stats">
          {
            stats.map((stat) => (
              <div class="partnership__stat">
                <p class="partnership__stat-value">{stat.value}</p>
                <p class="partnership__stat-label">{stat.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="partnership__logos">
    {
      logos.map((logo) =>
        logo.greenish ? (
          <div class="partnership__logo-card partnership__logo-card--greenish">
            <span class="partnership__greenish">
              <img
                class="partnership__greenish-icon"
                src="/assets/images/logo-greenish-icon.svg"
                alt=""
                role="presentation"
                width="21"
                height="19"
              />
              <img
                class="partnership__greenish-text"
                src={logo.src}
                alt={logo.name}
                width={Math.round(logo.w)}
                height={Math.round(logo.h)}
              />
            </span>
          </div>
        ) : logo.card ? (
          <div class="partnership__logo-card">
            <img
              class="partnership__logo-img"
              src={logo.src}
              alt={logo.name}
              width={Math.round(logo.w)}
              height={Math.round(logo.h)}
              style={`width:${logo.w / 16}em;height:${logo.h / 16}em;`}
            />
          </div>
        ) : (
          <div class="partnership__logo-bare">
            <img
              class="partnership__logo-img"
              src={logo.src}
              alt={logo.name}
              width={Math.round(logo.w)}
              height={Math.round(logo.h)}
            />
          </div>
        )
      )
    }
  </div>
</section>

<style>
  .partnership {
    width: 100%;
    background-color: var(--color-bg-dark);
    padding-block: 4.5em; /* 72px */
    display: flex;
    flex-direction: column;
    gap: 4.5em; /* 72px */
    overflow: hidden;
  }

  .partnership__inner {
    padding-inline: var(--container-padding);
  }

  .partnership__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2em;
  }

  /* Tag */
  .partnership__tag {
    display: flex;
    align-items: center;
    gap: 0.5em; /* 8px */
    width: 17.25em; /* 276px */
    flex-shrink: 0;
  }

  .partnership__tag-dot {
    width: 0.25em; /* 4px */
    height: 0.25em;
    flex-shrink: 0;
  }

  .partnership__tag-label {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.875em; /* 14px */
    line-height: 1.4286; /* 20 / 14 */
    letter-spacing: 1.68px;
    text-transform: uppercase;
    color: var(--color-text-accent);
    white-space: nowrap;
  }

  /* Content */
  .partnership__content {
    display: flex;
    flex-direction: column;
    gap: 2em; /* 32px */
    width: 48.4375em; /* 775px */
    flex-shrink: 0;
  }

  .partnership__heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 3em; /* 48px */
    line-height: 1.1667; /* 56 / 48 */
    letter-spacing: -1.92px;
    color: var(--color-text-accent);
  }

  .partnership__body {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1em; /* 16px */
    line-height: 1.5; /* 24 / 16 */
    letter-spacing: -0.32px;
    color: #a0c347;
  }

  /* Stats */
  .partnership__stats {
    display: flex;
    gap: 0.125em; /* 2px */
    padding-top: 1.5em; /* 24px */
  }

  .partnership__stat {
    display: flex;
    flex-direction: column;
    gap: 1em; /* 16px */
    flex: 1 0 0;
    min-width: 0;
  }

  .partnership__stat-value {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 2.5em; /* 40px */
    line-height: 1;
    letter-spacing: -1.6px;
    color: var(--color-primary);
  }

  .partnership__stat-label {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.875em; /* 14px */
    line-height: 1.4286; /* 20 / 14 */
    letter-spacing: -0.28px;
    color: #a0c347;
  }

  /* Logo strip — full-bleed centered row, overflows container (clipped) */
  .partnership__logos {
    display: flex;
    gap: 0.75em; /* 12px */
    align-items: flex-start;
    justify-content: center;
    width: 100%;
  }

  .partnership__logo-card,
  .partnership__logo-bare {
    height: 4.5em; /* 72px */
    width: 12.5em; /* 200px */
    flex-shrink: 0;
  }

  .partnership__logo-card {
    background-color: #f7f9f2;
    border-radius: 1em; /* 16px */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0.802em; /* ~12.83px */
  }

  .partnership__logo-card--greenish {
    padding: 0.915em; /* ~14.64px */
  }

  .partnership__logo-bare {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .partnership__logo-bare .partnership__logo-img {
    width: 100%;
    height: 100%;
  }

  .partnership__logo-img {
    display: block;
    flex-shrink: 0;
  }

  /* Greenish lockup — leaf icon + wordmark */
  .partnership__greenish {
    display: inline-flex;
    align-items: center;
    gap: 0.25em; /* ~4px */
  }

  .partnership__greenish-icon {
    width: 1.3347em; /* ~21.36px */
    height: 1.1699em; /* ~18.72px */
    flex-shrink: 0;
    display: block;
  }

  .partnership__greenish-text {
    width: 4.8308em; /* ~77.29px */
    height: 0.9354em; /* ~14.97px */
    flex-shrink: 0;
    display: block;
  }

  /* ===== Responsive (layout only) ===== */
  @media screen and (max-width: 991px) {
    .partnership__top {
      flex-direction: column;
      gap: 1.5em;
    }
    .partnership__tag,
    .partnership__content {
      width: 100%;
    }
  }

  @media screen and (max-width: 767px) {
    .partnership__logos {
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  @media screen and (max-width: 479px) {
    .partnership__stats {
      flex-direction: column;
      gap: 1.5em;
    }
  }
</style>
