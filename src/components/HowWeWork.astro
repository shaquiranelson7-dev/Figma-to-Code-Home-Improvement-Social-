---
// How We Work — 5-step process section (Upmind)
// Built strictly from Figma file sdLaVofRVJRIdYko2En4hi
// Nodes: 1:441, 257:1365, 257:1421, 257:1448, 257:1469

const steps = [
  {
    n: 1,
    eyebrow: "how we work",
    title: "Initial Diagnosis",
    description:
      "We assess your product, market, and key KPIs to understand your baseline.",
    numberStyle: "accent",
  },
  {
    n: 2,
    eyebrow: "how we work",
    title: "Strategic Audit",
    description:
      "We identify opportunities, risks, and gaps across product, growth, and GTM.",
    numberStyle: "white",
  },
  {
    n: 3,
    eyebrow: "how we work",
    title: "Action Roadmap",
    description:
      "We build a clear plan with priorities, objectives, and measurable deliverables.",
    numberStyle: "white",
  },
  {
    n: 4,
    eyebrow: "how we work",
    title: "Guided Execution",
    description:
      "We work alongside you to implement growth and optimization tactics.",
    numberStyle: "white",
  },
  {
    n: 5,
    eyebrow: "how we work",
    title: "Iteration & Metrics",
    description:
      "We measure results and refine the plan through continuous cycles.",
    numberStyle: "white",
  },
];
---

<section class="hww" aria-label="How we work">
  {steps.map((step) => (
    <article class="hww__step" data-step={step.n}>
      <div class="hww__panel">
        <div class="hww__menu">
          <span class="hww__eyebrow">{step.eyebrow}</span>
        </div>
        <div class="hww__copy">
          <h3 class="hww__title">{step.title}</h3>
          <p class="hww__desc">{step.description}</p>
        </div>
      </div>

      <div class="hww__media">
        {step.n === 1 && (
          <img
            class="hww__bg hww__bg--1"
            src="/assets/images/howwework-step1-bg.png"
            alt=""
            width="1856"
            height="2464"
            loading="lazy"
            decoding="async"
          />
        )}
        {step.n === 2 && (
          <img
            class="hww__bg hww__bg--2"
            src="/assets/images/howwework-step2-bg.png"
            alt=""
            width="2048"
            height="2048"
            loading="lazy"
            decoding="async"
          />
        )}
        {step.n === 3 && (
          <img
            class="hww__bg hww__bg--3"
            src="/assets/images/howwework-step3-bg.png"
            alt=""
            width="1024"
            height="1024"
            loading="lazy"
            decoding="async"
          />
        )}
        {step.n === 4 && (
          <img
            class="hww__bg hww__bg--4"
            src="/assets/images/howwework-step4-bg-overlay.png"
            alt=""
            width="1856"
            height="2464"
            loading="lazy"
            decoding="async"
          />
        )}
        {step.n === 5 && (
          <img
            class="hww__bg hww__bg--5"
            src="/assets/images/howwework-step5-bg.png"
            alt=""
            width="928"
            height="1232"
            loading="lazy"
            decoding="async"
          />
        )}

        <div class={`hww__pageno hww__pageno--${step.numberStyle} hww__pageno--p${step.n}`}>
          <span class="hww__pageno-cur">{step.n}</span>
          <span class="hww__pageno-sep">/</span>
          <span class="hww__pageno-tot">5</span>
        </div>

        {step.n === 1 && (
          <img
            class="hww__graphic hww__graphic--1"
            src="/assets/images/howwework-step1-graphic.svg"
            alt=""
            width="309"
            height="206"
            loading="lazy"
            decoding="async"
          />
        )}
        {step.n === 2 && (
          <div class="hww__graphic hww__graphic--2">
            <img class="hww__g2 hww__g2--a" src="/assets/images/howwework-step2-graphic-a.svg" alt="" width="12" height="275" loading="lazy" decoding="async" />
            <img class="hww__g2 hww__g2--b" src="/assets/images/howwework-step2-graphic-b.svg" alt="" width="12" height="275" loading="lazy" decoding="async" />
            <img class="hww__g2 hww__g2--c" src="/assets/images/howwework-step2-graphic-c.svg" alt="" width="12" height="275" loading="lazy" decoding="async" />
            <img class="hww__g2 hww__g2--d" src="/assets/images/howwework-step2-graphic-d.svg" alt="" width="12" height="275" loading="lazy" decoding="async" />
          </div>
        )}
        {step.n === 3 && (
          <img
            class="hww__graphic hww__graphic--3"
            src="/assets/images/howwework-step3-graphic.svg"
            alt=""
            width="275"
            height="275"
            loading="lazy"
            decoding="async"
          />
        )}
        {step.n === 4 && (
          <img
            class="hww__graphic hww__graphic--4"
            src="/assets/images/howwework-step4-graphic.svg"
            alt=""
            width="188"
            height="275"
            loading="lazy"
            decoding="async"
          />
        )}
        {step.n === 5 && (
          <img
            class="hww__graphic hww__graphic--5"
            src="/assets/images/howwework-step5-graphic.svg"
            alt=""
            width="275"
            height="275"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
    </article>
  ))}
</section>

<style>
  /* ===== 1280 design frame: 1em = 16px ===== */
  .hww {
    display: block;
    width: 100%;
    background-color: #0c0c0c;
  }

  .hww__step {
    display: flex;
    align-items: stretch;
    width: 100%;
    background-color: #0c0c0c;
  }

  /* Left panel */
  .hww__panel {
    flex: 1 0 0;
    min-width: 1px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    background-color: var(--color-bg-dark);
    padding: 3.25em; /* 52px */
    min-height: 42em; /* 672px right panel height */
  }

  .hww__menu {
    display: flex;
    align-items: center;
  }

  .hww__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.5em; /* 40px */
    padding-block: 0.75em; /* 12px */
    border-radius: 3em; /* 48px */
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 1em; /* 16px */
    line-height: 1.5; /* 24/16 */
    letter-spacing: 2.56px;
    text-transform: uppercase;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .hww__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1em; /* 16px */
    width: 22.5625em; /* 361px */
    max-width: 100%;
  }

  .hww__title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 3em; /* 48px */
    line-height: 1.1667; /* 56/48 */
    letter-spacing: -1.92px;
    color: var(--color-text-accent);
  }

  .hww__desc {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1em; /* 16px */
    line-height: 1.5; /* 24/16 */
    letter-spacing: -0.32px;
    color: rgba(183, 254, 2, 0.8);
  }

  /* Right media panel */
  .hww__media {
    position: relative;
    flex: 0 0 40em; /* 640px */
    width: 40em;
    height: 42em; /* 672px */
    overflow: hidden;
  }

  .hww__bg {
    position: absolute;
    object-fit: cover;
    pointer-events: none;
    max-width: none;
  }

  /* Per-step background placement (Figma offsets, 1em = 16px) */
  .hww__bg--1 {
    width: 43.5625em; /* 697px */
    height: 57.8125em; /* 925px */
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }
  .hww__bg--2 {
    width: 54.125em; /* 866px */
    height: 54.125em;
    left: calc(50% - 1.1875em); /* 50% - 19px */
    top: -5.8125em; /* -93px */
    transform: translateX(-50%);
  }
  .hww__bg--3 {
    width: 49.6875em; /* 795px */
    height: 49.6875em;
    left: calc(50% - 1.25em); /* 50% - 20px */
    top: -5.8125em; /* -93px */
    transform: translateX(-50%);
  }
  .hww__bg--4 {
    /* image 2357 overlay: 702x932 at left -47px top 0 */
    width: 43.875em; /* 702px */
    height: 58.25em; /* 932px */
    left: -2.9375em; /* -47px */
    top: 0;
  }
  .hww__bg--5 {
    width: 43.375em; /* 694px */
    height: 57.625em; /* 922px */
    left: calc(50% + 0.75em); /* 50% + 12px */
    top: -9.375em; /* -150px */
    transform: translateX(-50%);
  }

  /* Page number "N / 5" */
  .hww__pageno {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5em; /* 8px */
    font-weight: 400;
    font-size: 3em; /* 48px */
    line-height: 1.1667; /* 56/48 */
    letter-spacing: -1.44px;
    white-space: nowrap;
  }

  /* Step 1 uses mono + accent color, positioned left:507 top:52 */
  .hww__pageno--p1 {
    font-family: var(--font-mono);
    left: 31.6875em; /* 507px */
    top: 3.25em; /* 52px */
  }
  /* Steps 2-5 use Geist, right:40 top:40 */
  .hww__pageno--p2,
  .hww__pageno--p3,
  .hww__pageno--p4,
  .hww__pageno--p5 {
    font-family: var(--font-heading);
    right: 2.5em; /* 40px */
    top: 2.5em; /* 40px */
    justify-content: flex-end;
    text-align: right;
  }

  .hww__pageno--accent .hww__pageno-cur {
    color: var(--color-primary);
  }
  .hww__pageno--accent .hww__pageno-sep,
  .hww__pageno--accent .hww__pageno-tot {
    color: rgba(183, 254, 2, 0.4);
  }
  .hww__pageno--white .hww__pageno-cur {
    color: var(--color-text-white);
  }
  .hww__pageno--white .hww__pageno-sep,
  .hww__pageno--white .hww__pageno-tot {
    color: rgba(255, 255, 255, 0.4);
  }

  /* Decorative concentric / vector graphics */
  .hww__graphic {
    position: absolute;
    pointer-events: none;
    display: block;
  }

  /* Step 1: green concentric, box 364.65px at left:142 top:154, rotated -45 */
  .hww__graphic--1 {
    width: 19.3384em; /* 309.415px */
    height: 12.8923em; /* 206.277px */
    left: 8.875em; /* 142px */
    top: 9.625em; /* 154px */
    /* center within 364.65px box then rotate -45 */
    transform: translate(2.539em, 4.761em) rotate(-45deg);
  }

  /* Step 2: 4 dot-line groups forming the diamond grid */
  .hww__graphic--2 {
    position: absolute;
    left: 11.375em; /* 182.01px */
    top: 12.4375em; /* 199px */
    width: 17.1875em; /* ~275px span */
    height: 17.1875em;
  }
  .hww__g2 {
    position: absolute;
    width: 0.7475em; /* 11.956px */
    height: 17.187em; /* 274.998px */
  }
  .hww__g2--a {
    left: 8.219em; /* 313.52 - 182.01 = 131.51px */
    top: 0;
  }
  .hww__g2--b {
    left: 2.252em; /* 218.05 - 182.01 = 36.04 + center offset */
    top: 2.253em;
    transform: rotate(-45deg);
  }
  .hww__g2--c {
    left: 0;
    top: 8.219em; /* 330.52 - 199 = 131.52px */
    transform: rotate(-90deg);
  }
  .hww__g2--d {
    left: 2.252em;
    top: 2.253em;
    transform: rotate(-135deg);
  }

  /* Step 3: radial burst, 275px box at left:183 top:199 */
  .hww__graphic--3 {
    width: 17.1875em; /* 275px */
    height: 17.1875em;
    left: 11.4375em; /* 183px */
    top: 12.4375em; /* 199px */
  }

  /* Step 4: triangles union, 188.39x275 centered in 327.666 box left:156.33 top:171.55 rotate 135 */
  .hww__graphic--4 {
    width: 11.7744em; /* 188.39px */
    height: 17.1875em; /* 275px */
    left: 9.7706em; /* 156.33px */
    top: 10.7219em; /* 171.55px */
    transform: translate(4.336em, 1.582em) rotate(135deg);
  }

  /* Step 5: concentric circles, 275px box at left:183 top:199 */
  .hww__graphic--5 {
    width: 17.1875em; /* 275px */
    height: 17.1875em;
    left: 11.4375em; /* 183px */
    top: 12.4375em; /* 199px */
  }

  /* ===== Responsive: split -> stacked (layout only) ===== */
  @media (max-width: 991px) {
    .hww__step {
      flex-direction: column;
    }
    .hww__panel {
      min-height: auto;
      width: 100%;
    }
    .hww__media {
      flex: 0 0 auto;
      width: 100%;
      height: 36em;
    }
    .hww__bg {
      width: 100%;
      height: auto;
      min-height: 100%;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
    }
    .hww__bg--4 {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
    }
    .hww__pageno--p1 {
      left: auto;
      right: 2.5em;
      top: 2.5em;
    }
  }

  @media (max-width: 767px) {
    .hww__media {
      height: 28em;
    }
    .hww__graphic--1,
    .hww__graphic--3,
    .hww__graphic--4,
    .hww__graphic--5,
    .hww__graphic--2 {
      transform-origin: top left;
    }
  }

  @media (max-width: 479px) {
    .hww__media {
      height: 22em;
    }
    .hww__pageno {
      font-size: 2.25em;
    }
  }
</style>
