---
// About Us section — Upmind landing page
// Built strictly from Figma node 1:350 (file sdLaVofRVJRIdYko2En4hi)
const tags = [
  "Professional",
  "Strategic",
  "AI-Focused",
  "Startup Feel",
  "Smarter",
  "Grow Faster",
  "Build Smart",
  "Simple",
];
---

<section class="about">
  <div class="about__inner container">
    <!-- Left: text column -->
    <div class="about__text">
      <p class="eyebrow about__eyebrow">ABout us</p>

      <div class="about__copy">
        <h2 class="about__title">
          We help startups make smarter decisions and grow with clarity.
        </h2>
        <p class="about__subtitle">
          We bring strategic clarity, actionable insights, and modern processes
          to help you validate, launch, and scale products with confidence.
        </p>
      </div>

      <a href="#" class="btn btn-dark about__btn">Learn More</a>
    </div>

    <!-- Right: performance stat card -->
    <div class="about__card">
      <div class="about__card-inner">
        <div class="about__card-header">
          <div class="about__card-header-text">
            <p class="about__card-title">Performance</p>
            <p class="about__card-sub">In the past 7 days</p>
          </div>
          <img
            class="about__card-icon"
            src="/assets/images/icon-show-chart.svg"
            alt=""
            width="35"
            height="35"
          />
        </div>

        <div class="about__stat">
          <div class="about__stat-row">
            <p class="about__stat-value">49%</p>
            <span class="about__stat-badge">+2.5%</span>
          </div>
          <div class="about__stat-label">
            <p>Business growth</p>
          </div>
        </div>

        <div class="about__tags">
          {tags.map((tag) => <span class="about__tag">{tag}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    width: 100%;
    background-color: var(--color-bg-white);
  }

  .about__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4em;
    padding-block: 8.75em;
    padding-inline: var(--container-padding);
  }

  /* ---------- Left text column ---------- */
  .about__text {
    flex: 1 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5em;
  }

  .about__eyebrow {
    color: var(--color-text-primary);
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1em;
    width: 100%;
  }

  .about__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 3em;
    font-weight: 400;
    line-height: 1.167;
    letter-spacing: -1.92px;
    color: var(--color-text-primary);
  }

  .about__subtitle {
    margin: 0;
    max-width: 32.875em;
    font-family: var(--font-body);
    font-size: 1em;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.32px;
    color: var(--color-text-secondary);
  }

  .about__btn {
    height: 2.75em;
    padding-inline: 1.5em;
    border-radius: 2em;
    font-family: var(--font-mono);
    font-size: 0.875em;
    font-weight: 400;
    line-height: 1.429;
    letter-spacing: 1.68px;
    text-transform: uppercase;
    color: var(--color-text-accent);
  }

  /* ---------- Right stat card ---------- */
  .about__card {
    flex-shrink: 0;
    width: 19.4375em;
    height: 19.4375em;
    background-color: var(--color-bg-dark);
    border: 1px solid var(--color-bg-dark);
    border-radius: 1.453em;
    padding: 0.457em;
    overflow: hidden;
  }

  .about__card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
  }

  .about__card-header {
    display: flex;
    align-items: center;
    gap: 0.914em;
    width: 100%;
    padding: 0.457em;
    background-color: #e6ecd6;
    border-radius: 1.09em;
  }

  .about__card-header-text {
    flex: 1 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.457em;
    white-space: nowrap;
  }

  .about__card-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.5em;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.96px;
    color: #131313;
  }

  .about__card-sub {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.625em;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.4px;
    color: rgba(19, 19, 19, 0.4);
  }

  .about__card-icon {
    flex-shrink: 0;
    width: 2.18em;
    height: 2.18em;
  }

  .about__stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5em;
    width: 100%;
    padding: 0.457em;
  }

  .about__stat-row {
    display: flex;
    align-items: flex-end;
    gap: 0.363em;
  }

  .about__stat-value {
    margin: 0;
    font-family: var(--font-body);
    font-size: 2.907em;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -1.86px;
    color: var(--color-primary);
  }

  .about__stat-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 0.727em;
    padding-inline: 0.363em;
    background-color: #cdfad1;
    border-radius: 0.727em;
    font-family: var(--font-body);
    font-size: 0.363em;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.23px;
    color: var(--color-bg-dark);
    white-space: nowrap;
  }

  .about__stat-label {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 0.25em;
  }

  .about__stat-label p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.686em;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.44px;
    color: rgba(255, 255, 255, 0.4);
    white-space: nowrap;
  }

  .about__tags {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    align-items: center;
    justify-content: center;
    gap: 0.485em;
    width: 33.716em;
  }

  .about__tag {
    display: flex;
    align-items: center;
    padding: 0.611em 1.221em;
    background-color: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 2.426em;
    font-family: var(--font-body);
    font-size: 0.916em;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.59px;
    color: var(--color-text-white);
    white-space: nowrap;
  }

  /* ---------- Responsive (layout only) ---------- */
  @media (max-width: 991px) {
    .about__inner {
      gap: 3em;
    }
  }

  @media (max-width: 767px) {
    .about__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 3em;
      padding-block: 5em;
    }

    .about__card {
      align-self: center;
    }
  }

  @media (max-width: 479px) {
    .about__btn {
      width: 100%;
    }
  }
</style>
