---
// CTA — call-to-action section for the Upmind landing page.
// Content hardcoded from Figma (file sdLaVofRVJRIdYko2En4hi, node 1:584).
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta__bg">
    <img
      class="cta__bg-img"
      src="/assets/images/cta-background.png"
      alt=""
      width="2688"
      height="1792"
      loading="lazy"
      decoding="async"
    />
    <div class="cta__overlay" aria-hidden="true"></div>
  </div>

  <div class="cta__inner container">
    <div class="cta__text">
      <h2 id="cta-title" class="cta__title">
        Ready to<br />elevate your business?
      </h2>
      <p class="cta__subtitle">
        Partner with us to take your digital presence to the next level.
      </p>
    </div>

    <div class="cta__actions">
      <a href="#" class="cta__btn cta__btn--glass">View Demo</a>
      <a href="#" class="cta__btn cta__btn--primary">Book a Call</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    width: 100%;
    min-height: 41.9375em; /* 671px */
    background-color: var(--color-bg-dark);
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .cta__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Dark gradient overlay — present in the Figma design */
  .cta__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(16, 22, 4, 0) 36.885%,
      rgba(16, 22, 4, 0.8) 67.508%,
      var(--color-bg-dark) 94.402%
    );
  }

  .cta__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: var(--container-padding);
    padding-block: 4em;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2em; /* 32px */
    /* Content sits below the vertical centre, as in the design */
    margin-top: 16em;
  }

  .cta__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75em; /* 12px */
    text-align: center;
  }

  .cta__title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 4em; /* 64px */
    line-height: 1.125; /* 72/64 */
    letter-spacing: -2.56px;
    color: var(--color-text-white);
  }

  .cta__subtitle {
    margin: 0;
    max-width: 31.1875em; /* 499px */
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1em; /* 16px */
    line-height: 1.5; /* 24/16 */
    letter-spacing: -0.32px;
    color: var(--color-text-white);
  }

  .cta__actions {
    display: flex;
    gap: 1em; /* 16px */
    align-items: flex-start;
  }

  .cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875em; /* 14px */
    line-height: 1.4286; /* 20/14 */
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .cta__btn--glass {
    padding: 0.75em 1.5em; /* 12px 24px */
    border-radius: 3em; /* 48px */
    border: 1px solid rgba(255, 255, 255, 0.2);
    background-color: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--color-text-white);
    font-weight: 500;
    letter-spacing: 2.24px;
  }

  .cta__btn--glass:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  .cta__btn--primary {
    height: 2.75em; /* 44px */
    padding: 0.25em 1.5em; /* 4px 24px */
    border-radius: 2em; /* 32px */
    background-color: var(--color-primary);
    color: var(--color-bg-dark);
    font-weight: 400;
    letter-spacing: 1.68px;
  }

  .cta__btn--primary:hover {
    opacity: 0.9;
  }

  @media (max-width: 991px) {
    .cta {
      min-height: auto;
    }

    .cta__inner {
      margin-top: 0;
      padding-block: 5em;
    }

    .cta__title {
      font-size: 3em;
    }
  }

  @media (max-width: 767px) {
    .cta__title {
      font-size: 2.25em;
    }
  }

  @media (max-width: 479px) {
    .cta__title {
      font-size: 1.875em;
    }

    .cta__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .cta__btn {
      width: 100%;
    }
  }
</style>
