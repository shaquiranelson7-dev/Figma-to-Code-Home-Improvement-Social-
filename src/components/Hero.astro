---
// Hero — full-bleed background image with the transparent Navbar overlaid on top.
// Built strictly from Figma node 3475:1365 (file sdLaVofRVJRIdYko2En4hi).
import Navbar from "./Navbar.astro";

// Floating glass tags (Figma nodes 3475:1379 / 1389 / 1399 / 1409 / 1419).
// `pos` values are percentages of the 1280 x 854 design frame.
const tags = [
  {
    label: "Strategic",
    icon: "/assets/images/icon-ai-strategic.svg",
    color: "#b7fe02",
    pos: { top: "52.22%", left: "67.73%" },
  },
  {
    label: "Build Smart",
    icon: "/assets/images/icon-ai-build.svg",
    color: "#7ddafc",
    pos: { top: "50.82%", left: "22.58%" },
  },
  {
    label: "Grow Faster",
    icon: "/assets/images/icon-ai-grow.svg",
    color: "#edff75",
    pos: { top: "76.58%", left: "13.59%" },
  },
  {
    label: "Professional",
    icon: "/assets/images/icon-ai-startup.svg",
    color: "#fe86a6",
    pos: { top: "71.90%", left: "79.22%" },
  },
  {
    label: "Startup Feel",
    icon: "/assets/images/icon-ai-startup.svg",
    color: "#f79bf7",
    pos: { top: "85.71%", left: "71.17%" },
  },
];
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <img
      class="hero__bg-img"
      src="/assets/images/hero-background.png"
      alt=""
      width="2912"
      height="1632"
    />
    <div class="hero__bg-fade"></div>
  </div>

  <Navbar />

  {
    tags.map((tag) => (
      <div
        class="hero__tag"
        style={`top:${tag.pos.top};left:${tag.pos.left};`}
        aria-hidden="true"
      >
        <span class="hero__tag-icon" style={`background-color:${tag.color};`}>
          <img src={tag.icon} alt="" width="16" height="16" />
        </span>
        <span class="hero__tag-label">{tag.label}</span>
      </div>
    ))
  }

  <div class="hero__inner container">
    <div class="hero__copy">
      <h1 class="hero__title">
        Clear insights. Real strategy. Sustainable growth.
      </h1>
      <p class="hero__subtitle">
        We help startups and growing teams validate ideas, scale products, and
        make data-driven decisions.
      </p>
    </div>

    <div class="hero__actions">
      <a class="hero__btn hero__btn--glass" href="#">View Demo</a>
      <a class="hero__btn hero__btn--primary" href="#">Book a Call</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 53.375em; /* 854px on 1280 frame */
    overflow: hidden;
    background-color: var(--color-bg-dark);
    isolation: isolate;
  }

  /* Full-bleed background image + bottom fade to dark */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero__bg-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(16, 22, 4, 0) 46.194%,
      #101604 100%
    );
  }

  /* Inner content — constrained, bottom-aligned, centered text */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2em; /* 32px */
    min-height: 53.375em;
    padding-top: 32.375em; /* content sits at y=518 on 854 frame */
    padding-bottom: 5.5em;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75em; /* 12px */
    width: 50em; /* 800px — constrained on the parent so it does not
                    compound with the heading's own font-size */
    max-width: 100%;
    text-align: center;
  }

  .hero__title {
    width: 100%;
    font-family: var(--font-heading);
    font-size: 4em; /* 64px */
    font-weight: 400;
    line-height: 1.125; /* 72 / 64 */
    letter-spacing: -2.56px;
    color: var(--color-text-white);
  }

  .hero__subtitle {
    width: 31.1875em; /* 499px */
    max-width: 100%;
    font-family: var(--font-body);
    font-size: 1em; /* 16px */
    font-weight: 400;
    line-height: 1.5; /* 24 / 16 */
    letter-spacing: -0.32px;
    color: var(--color-text-white);
  }

  .hero__actions {
    display: flex;
    align-items: flex-start;
    gap: 1em; /* 16px */
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875em; /* 14px */
    line-height: 1.4286; /* 20 / 14 */
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .hero__btn--glass {
    padding: 0.75em 1.75em; /* 12px / 28px (24 + 4 wrap) */
    border-radius: 3em; /* 48px */
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--color-text-white);
    font-weight: 500;
    letter-spacing: 2.24px;
  }

  .hero__btn--primary {
    height: 2.75em; /* 44px */
    padding: 0.25em 1.75em; /* 4px / 28px */
    border-radius: 2em; /* 32px */
    background-color: var(--color-primary);
    color: var(--color-bg-dark);
    font-weight: 400;
    letter-spacing: 1.68px;
  }

  /* Floating glass tags */
  .hero__tag {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.25em; /* 4px */
    padding: 0.25em 1em 0.25em 0.25em; /* 4 / 16 / 4 / 4 */
    border-radius: 3em; /* 48px */
    background-color: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero__tag-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2em; /* 32px */
    height: 2em;
    border-radius: 2.5em; /* 40px */
    flex-shrink: 0;
  }

  .hero__tag-icon img {
    width: 1em; /* 16px */
    height: 1em;
  }

  .hero__tag-label {
    font-family: var(--font-heading);
    font-size: 0.875em; /* 14px */
    font-weight: 500;
    line-height: 1.4286; /* 20 / 14 */
    letter-spacing: -0.28px;
    color: var(--color-text-white);
    white-space: nowrap;
  }

  /* Tablet */
  @media (max-width: 991px) {
    .hero,
    .hero__inner {
      min-height: 0;
    }

    .hero__inner {
      padding-top: 11em;
      padding-bottom: 5em;
    }

    .hero__title {
      width: 100%;
    }

    .hero__subtitle {
      width: 100%;
      max-width: 34em;
    }

    /* Floating tags clutter narrow viewports — hide below desktop */
    .hero__tag {
      display: none;
    }
  }

  /* Mobile landscape */
  @media (max-width: 767px) {
    .hero__inner {
      padding-top: 9em;
      padding-bottom: 4em;
    }

    .hero__actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .hero__btn {
      width: 100%;
    }
  }

  /* Mobile portrait */
  @media (max-width: 479px) {
    .hero__inner {
      padding-top: 8em;
    }
  }
</style>
